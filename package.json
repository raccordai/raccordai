{
  "name": "raccord",
  "productName": "Raccord",
  "version": "1.4.0",
  "description": "Raccord — AI video studio (desktop)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Romain Manniez <romainmanniez@gmail.com>",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:coverage": "node scripts/run-vitest.mjs run --coverage",
    "e2e": "node e2e/run.mjs",
    "test:assistant": "node e2e/run.mjs assistant",
    "db:generate": "drizzle-kit generate",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "lefthook",
      "electron-winstaller",
      "esbuild",
      "better-sqlite3",
      "ffmpeg-static",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/darwin-x64",
      "@ffprobe-installer/linux-x64",
      "@ffprobe-installer/linux-arm64",
      "uiohook-napi"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@dagrejs/dagre": "^3.1.2",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.13",
    "i18next": "^26.5.10",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uiohook-napi": "^1.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "electron": "^43.8.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
