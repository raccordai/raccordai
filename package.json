{
  "name": "raccord",
  "productName": "Raccord",
  "version": "0.2.0",
  "description": "Raccord — AI video studio (desktop)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Romain Manniez <romainmanniez@gmail.com>",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:coverage": "node scripts/run-vitest.mjs run --coverage",
    "test:assistant": "node scripts/assistant-e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "lefthook",
      "electron-winstaller",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@dagrejs/dagre": "^3.0.0",
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "hono": "^4.12.28",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "lefthook": "^2.1.10",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
